<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TMG Digital — Landing Page</title>
  
  <!-- Basecoat CSS -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/basecoat-css@1.0.2/dist/basecoat.cdn.min.css">
  
  <!-- Shell API -->
  <link rel="stylesheet" href="shell.css">
  <script src="shell.js" defer></script>

  <style>
    /* System theme tokens customized for TMG Digital (Deep Forest Green + Sun Gold + Sky Blue) */
    :root {
      --accent: #f5b942;
      --accent-hover: #e5a730;
      --accent-text: #f5b942;
      --accent-contrast: #0a1f16;
      --sky: #38bdf8;
      --sky-hover: #7dd3fc;
      --bg: #0a1f16;
      --bg-darker: #06160f;
      --surface: #0f2c20;
      --surface-elevated: #153a2a;
      --border: #1e4835;
      --border-focus: #38bdf8;
      --text: #eef7f2;
      --text-muted: #94afa3;
      --font-stack: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg);
      color: var(--text);
      font-family: var(--font-stack);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    /* Header & Navigation */
    .site-header {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(10, 31, 22, 0.92);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--border);
      transition: border-color 0.2s ease;
    }

    .header-inner {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0.9rem 1.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
    }

    .logo {
      font-size: 1.35rem;
      font-weight: 800;
      letter-spacing: -0.03em;
      display: inline-flex;
      align-items: center;
      color: #ffffff;
      user-select: none;
    }

    .logo .dot {
      color: var(--accent);
      font-size: 1.5rem;
      line-height: 0;
      margin: 0 1px;
    }

    .logo .digital {
      color: #cde2d7;
      font-weight: 600;
    }

    .nav-desktop {
      display: flex;
      align-items: center;
      gap: 2rem;
    }

    .nav-desktop a {
      font-size: 0.93rem;
      font-weight: 500;
      color: var(--text-muted);
      transition: color 0.2s ease;
    }

    .nav-desktop a:hover,
    .nav-desktop a:focus-visible {
      color: var(--sky);
    }

    /* Buttons */
    .btn-cta {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.65rem 1.35rem;
      border-radius: 8px;
      font-weight: 700;
      font-size: 0.93rem;
      background-color: var(--accent);
      color: var(--accent-contrast);
      border: 1px solid transparent;
      cursor: pointer;
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
      text-decoration: none;
      white-space: nowrap;
    }

    .btn-cta:hover {
      background-color: var(--accent-hover);
      color: var(--accent-contrast);
      transform: translateY(-1px);
      box-shadow: 0 4px 16px rgba(245, 185, 66, 0.35);
    }

    .btn-cta:active {
      transform: translateY(0);
    }

    .btn-outline {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.65rem 1.35rem;
      border-radius: 8px;
      font-weight: 600;
      font-size: 0.93rem;
      background-color: transparent;
      color: var(--sky);
      border: 1px solid rgba(56, 189, 248, 0.4);
      cursor: pointer;
      transition: all 0.2s ease;
      text-decoration: none;
    }

    .btn-outline:hover {
      background-color: rgba(56, 189, 248, 0.12);
      border-color: var(--sky-hover);
      color: #ffffff;
    }

    /* Mobile Hamburger */
    .mobile-menu-btn {
      display: none;
      background: transparent;
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 0.5rem;
      cursor: pointer;
      color: var(--text);
    }

    .mobile-menu-btn svg {
      width: 22px;
      height: 22px;
      display: block;
    }

    .mobile-nav-panel {
      display: none;
      flex-direction: column;
      gap: 1.25rem;
      padding: 1.25rem 1.5rem 1.75rem;
      background-color: var(--surface);
      border-bottom: 1px solid var(--border);
    }

    .mobile-nav-panel.open {
      display: flex;
    }

    .mobile-nav-panel a {
      font-size: 1.05rem;
      font-weight: 500;
      color: var(--text);
      padding: 0.4rem 0;
    }

    /* Common Layout Container */
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    .section-spacing {
      padding: 5.5rem 0;
    }

    .section-darker {
      background-color: var(--bg-darker);
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
    }

    .section-head {
      text-align: center;
      max-width: 760px;
      margin: 0 auto 3.5rem;
    }

    .section-label {
      display: inline-block;
      font-size: 0.8rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--sky);
      margin-bottom: 0.6rem;
    }

    .section-head h2 {
      font-size: 2.2rem;
      font-weight: 700;
      letter-spacing: -0.03em;
      margin-bottom: 0.75rem;
      color: #ffffff;
    }

    .section-head p {
      font-size: 1.08rem;
      color: var(--text-muted);
    }

    /* Hero Section */
    .hero-section {
      padding: 7rem 0 5.5rem;
      position: relative;
      overflow: hidden;
      background-color: var(--bg);
    }

    .hero-media {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 0;
      overflow: hidden;
      pointer-events: none;
    }

    .hero-video {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      display: block;
    }

    .hero-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(8, 25, 17, 0.68) 0%, rgba(8, 25, 17, 0.38) 60%, rgba(8, 25, 17, 0.55) 100%);
      z-index: 1;
    }

    .hero-content {
      position: relative;
      z-index: 2;
      max-width: 880px;
      margin: 0 auto;
      text-align: center;
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      padding: 0.45rem 1.05rem;
      border-radius: 9999px;
      background-color: rgba(56, 189, 248, 0.1);
      border: 1px solid rgba(56, 189, 248, 0.28);
      font-size: 0.88rem;
      font-weight: 600;
      color: var(--sky);
      margin-bottom: 1.75rem;
      backdrop-filter: blur(8px);
    }

    .hero-title {
      font-size: clamp(2.3rem, 5vw, 3.8rem);
      line-height: 1.15;
      font-weight: 800;
      letter-spacing: -0.035em;
      color: #ffffff;
      margin-bottom: 1.5rem;
      text-shadow: 0 2px 14px rgba(0, 0, 0, 0.55);
    }

    .hero-title .highlight {
      color: var(--accent);
      display: inline-block;
    }

    .hero-desc {
      font-size: clamp(1.05rem, 2vw, 1.25rem);
      color: #cde2d7;
      max-width: 740px;
      margin: 0 auto 2.25rem;
      line-height: 1.6;
      text-shadow: 0 1px 8px rgba(0, 0, 0, 0.55);
    }

    .hero-actions {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 1rem;
      flex-wrap: wrap;
      margin-bottom: 2rem;
    }

    .hero-actions .btn-cta,
    .hero-actions .btn-outline {
      padding: 0.85rem 1.8rem;
      font-size: 1.02rem;
    }

    .hero-note {
      font-size: 0.9rem;
      color: var(--text-muted);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      text-shadow: 0 1px 6px rgba(0, 0, 0, 0.6);
    }

    /* Trust Bar */
    .trust-bar {
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
      background-color: var(--surface);
      padding: 1.5rem 0;
    }

    .trust-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 1.25rem;
    }

    .trust-title {
      font-size: 0.92rem;
      font-weight: 600;
      color: #eef7f2;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .trust-pills {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.75rem;
    }

    .trust-pill {
      font-size: 0.84rem;
      padding: 0.35rem 0.85rem;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid var(--border);
      border-radius: 6px;
      color: var(--text-muted);
      transition: border-color 0.2s ease, color 0.2s ease;
    }

    .trust-pill:hover {
      border-color: rgba(56, 189, 248, 0.4);
      color: #ffffff;
    }

    /* Services Grid */
    .services-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 1.5rem;
    }

    .service-card {
      background-color: var(--surface);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 2rem;
      display: flex;
      flex-direction: column;
      transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .service-card:hover {
      transform: translateY(-3px);
      border-color: rgba(56, 189, 248, 0.45);
      box-shadow: 0 10px 24px -10px rgba(0, 0, 0, 0.6);
    }

    .service-icon {
      font-size: 2.2rem;
      line-height: 1;
      margin-bottom: 1.25rem;
      display: inline-block;
    }

    .service-card h3 {
      font-size: 1.3rem;
      font-weight: 700;
      color: #ffffff;
      margin-bottom: 0.75rem;
    }

    .service-card p {
      color: var(--text-muted);
      font-size: 0.95rem;
      line-height: 1.6;
      flex-grow: 1;
    }

    /* Installer Showcase Band */
    .installer-band {
      position: relative;
      min-height: 420px;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
      background-color: var(--surface);
    }

    .installer-band-bg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center 35%;
      z-index: 0;
    }

    .installer-band-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(10, 31, 22, 0.86) 0%, rgba(10, 31, 22, 0.72) 50%, rgba(10, 31, 22, 0.9) 100%);
      z-index: 1;
    }

    .installer-band-content {
      position: relative;
      z-index: 2;
      text-align: center;
      max-width: 820px;
      padding: 4rem 1.5rem;
    }

    .installer-band-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.84rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--accent);
      background: rgba(10, 31, 22, 0.88);
      border: 1px solid rgba(245, 185, 66, 0.4);
      padding: 0.4rem 1rem;
      border-radius: 9999px;
      margin-bottom: 1.35rem;
      backdrop-filter: blur(8px);
    }

    .installer-band-quote {
      font-size: clamp(1.75rem, 3.8vw, 2.5rem);
      font-weight: 800;
      line-height: 1.25;
      letter-spacing: -0.025em;
      color: #ffffff;
      text-shadow: 0 2px 14px rgba(0, 0, 0, 0.6);
    }

    /* S.O.L.A.R. Framework Section */
    .solar-section-head-flex {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 2.5rem;
      margin-bottom: 3.5rem;
    }

    .solar-section-head-text {
      flex: 1;
      max-width: 650px;
    }

    .solar-section-head-text h2 {
      font-size: 2.2rem;
      font-weight: 700;
      letter-spacing: -0.03em;
      margin-bottom: 0.75rem;
      color: #ffffff;
    }

    .solar-section-head-text p {
      font-size: 1.08rem;
      color: var(--text-muted);
    }

    .solar-head-media {
      position: relative;
      flex-shrink: 0;
      width: 320px;
      height: 180px;
      border-radius: 12px;
      overflow: hidden;
      border: 1px solid var(--border);
      box-shadow: 0 10px 28px rgba(0, 0, 0, 0.45);
    }

    .solar-head-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.35s ease;
    }

    .solar-head-media:hover .solar-head-img {
      transform: scale(1.05);
    }

    .solar-head-badge {
      position: absolute;
      bottom: 0.65rem;
      left: 0.75rem;
      right: 0.75rem;
      font-size: 0.74rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      color: #ffffff;
      background: rgba(10, 31, 22, 0.88);
      backdrop-filter: blur(6px);
      padding: 0.3rem 0.65rem;
      border-radius: 6px;
      border: 1px solid rgba(56, 189, 248, 0.3);
      text-align: center;
    }

    .solar-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 1.5rem;
    }

    .solar-card {
      background-color: var(--surface);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 2.2rem;
      position: relative;
      display: flex;
      flex-direction: column;
      transition: border-color 0.2s ease;
    }

    .solar-card:hover {
      border-color: rgba(56, 189, 248, 0.45);
    }

    .solar-letter-box {
      display: flex;
      align-items: baseline;
      gap: 0.85rem;
      margin-bottom: 1rem;
    }

    .solar-letter {
      font-size: 2.75rem;
      font-weight: 900;
      line-height: 1;
      color: var(--sky);
      letter-spacing: -0.04em;
    }

    .solar-card h3 {
      font-size: 1.25rem;
      font-weight: 700;
      color: #ffffff;
    }

    .solar-card p {
      color: #cde2d7;
      font-size: 0.95rem;
      line-height: 1.65;
    }

    /* Process Section */
    .process-timeline {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
      position: relative;
    }

    .process-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 2.2rem;
      position: relative;
    }

    .step-number {
      font-size: 0.88rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      color: var(--sky);
      text-transform: uppercase;
      margin-bottom: 0.85rem;
      display: inline-block;
      background: rgba(56, 189, 248, 0.1);
      padding: 0.25rem 0.65rem;
      border-radius: 4px;
      border: 1px solid rgba(56, 189, 248, 0.28);
    }

    .process-card h3 {
      font-size: 1.35rem;
      font-weight: 700;
      color: #ffffff;
      margin-bottom: 0.75rem;
    }

    .process-card p {
      color: var(--text-muted);
      font-size: 0.95rem;
      line-height: 1.6;
    }

    /* Results Section */
    .results-global-block {
      margin-bottom: 2.75rem;
    }

    .results-block-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 0.75rem;
      margin-bottom: 1.35rem;
    }

    .block-badge {
      font-size: 0.8rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--sky);
    }

    .results-block-title {
      font-size: 1.35rem;
      font-weight: 700;
      color: #ffffff;
      letter-spacing: -0.02em;
    }

    .global-metrics-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1.15rem;
    }

    .metric-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 1.4rem 1.25rem;
      transition: transform 0.2s ease, border-color 0.2s ease;
    }

    .metric-card:hover {
      border-color: rgba(56, 189, 248, 0.4);
      transform: translateY(-2px);
    }

    .metric-card--highlight {
      border-color: rgba(245, 185, 66, 0.4);
      background: linear-gradient(180deg, rgba(245, 185, 66, 0.07) 0%, var(--surface) 100%);
    }

    .metric-value {
      font-size: 2rem;
      font-weight: 800;
      letter-spacing: -0.03em;
      color: #ffffff;
      line-height: 1.1;
      margin-bottom: 0.45rem;
    }

    .metric-value.gold {
      color: var(--accent);
    }

    .metric-label {
      font-size: 0.88rem;
      color: var(--text-muted);
      line-height: 1.4;
    }

    /* Featured Case Study */
    .featured-case-card {
      background: linear-gradient(145deg, #103325 0%, #153e2d 50%, #0c271c 100%);
      border: 1px solid rgba(245, 185, 66, 0.45);
      border-radius: 14px;
      padding: 2.25rem;
      box-shadow: 0 16px 36px -10px rgba(0, 0, 0, 0.55), 0 0 28px rgba(245, 185, 66, 0.08);
      margin-bottom: 2rem;
      overflow: hidden;
    }

    .featured-case-image-wrap {
      position: relative;
      height: 200px;
      border-radius: 10px;
      overflow: hidden;
      margin-bottom: 1.75rem;
      border: 1px solid var(--border);
      background-color: var(--surface);
    }

    .featured-case-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center 40%;
      display: block;
    }

    .featured-case-img-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(10, 31, 22, 0.25) 0%, rgba(10, 31, 22, 0.78) 100%);
    }

    .featured-case-img-caption {
      position: absolute;
      bottom: 0.85rem;
      left: 1rem;
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--sky);
      background: rgba(10, 31, 22, 0.88);
      border: 1px solid rgba(56, 189, 248, 0.35);
      padding: 0.28rem 0.75rem;
      border-radius: 6px;
      backdrop-filter: blur(6px);
    }

    .featured-case-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
      margin-bottom: 1.75rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .featured-case-tag {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: rgba(56, 189, 248, 0.12);
      border: 1px solid rgba(56, 189, 248, 0.3);
      padding: 0.35rem 0.85rem;
      border-radius: 9999px;
      font-size: 0.84rem;
      font-weight: 700;
      color: var(--sky);
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .pulse-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--sky);
      display: inline-block;
      box-shadow: 0 0 8px var(--sky);
    }

    .featured-case-note {
      font-size: 0.88rem;
      color: var(--text-muted);
    }

    .featured-case-hero {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1.5rem;
      padding: 1.4rem 1.6rem;
      background: rgba(6, 22, 15, 0.7);
      border-radius: 10px;
      border: 1px solid rgba(245, 185, 66, 0.28);
      margin-bottom: 1.75rem;
    }

    .featured-spend-revenue {
      display: flex;
      align-items: center;
      gap: 1.25rem;
      flex-wrap: wrap;
    }

    .spend-val-wrap, .revenue-val-wrap {
      display: flex;
      flex-direction: column;
    }

    .spend-label, .revenue-label {
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-muted);
      margin-bottom: 0.2rem;
    }

    .spend-val {
      font-size: 1.45rem;
      font-weight: 700;
      color: #eef7f2;
    }

    .arrow-separator {
      color: var(--sky);
      font-size: 1.6rem;
      line-height: 1;
    }

    .revenue-val.gold {
      font-size: 2.25rem;
      font-weight: 900;
      color: var(--accent);
      letter-spacing: -0.03em;
      line-height: 1;
    }

    .featured-hero-roas {
      text-align: right;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
    }

    .hero-roas-num.gold {
      font-size: 2.75rem;
      font-weight: 900;
      color: var(--accent);
      letter-spacing: -0.04em;
      line-height: 1;
    }

    .hero-roas-label {
      font-size: 0.82rem;
      font-weight: 700;
      color: var(--sky);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-top: 0.25rem;
    }

    .featured-stats-subgrid {
